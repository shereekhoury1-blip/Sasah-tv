.top-title {
    font-size: 20px;
    font-weight: 700;
}

.top-actions {
    margin-right: auto;
}

.icon-btn {
    background: none;
    border: none;
    color: var(--text);
    font-size: 18px;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: 0.3s;
