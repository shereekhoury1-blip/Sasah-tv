/* ===== متغيرات ===== */
:root {
    --bg: #0a0a0f;
    --bg2: #12121a;
    --card: #1a1a25;
    --card-hover: #22222f;
    --text: #ffffff;
    --text2: #8a8a9a;
    --accent: #e50914;
    --accent2: #ff2d3f;
    --border: #2a2a3a;
    --radius: 12px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Cairo', sans-serif;
}

body {
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
}

.hidden { display: none !important; }

/* ===== شاشة تسجيل الدخول ===== */
.login-screen {
    position: fixed;
    inset: 0;
    background: linear-gradient(135deg, #0a0a0f 0%, #1a0a0f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.login-box {
    background: var(--card);
    padding: 50px 40px;
    border-radius: 20px;
    text-align: center;
    width: 400px;
    max-width: 90%;
    box-shadow: 0 20px 60px rgba(229,9,20,0.15);
    border: 1px solid var(--border);
}

.logo {
    margin-bottom: 30px;
}

.logo i {
    font-size: 50px;
    color: var(--accent);
    margin-bottom: 10px;
}

.logo h1 {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 2px;
}

.subtitle {
    color: var(--text2);
    margin-bottom: 25px;
    font-size: 14px;
}

.input-group {
    position: relative;
    margin-bottom: 20px;
}

.input-group i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text2);
}

.input-group input {
    width: 100%;
    padding: 15px 45px 15px 15px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-size: 16px;
    text-align: center;
    letter-spacing: 3px;
    transition: 0.3s;
}

.input-group input:focus {
    border-color: var(--accent);
    outline: none;
}

.btn-login {
    width: 100%;
    padding: 15px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}

.btn-login:hover {
    background: var(--accent2);
    transform: translateY(-2px);
}

.error-msg {
    color: var(--accent);
    margin-top: 15px;
    font-size: 14px;
}

.hint {
    margin-top: 20px;
    color: var(--text2);
    font-size: 13px;
}

.hint span {
    color: var(--accent);
    font-weight: 700;
}

/* ===== التطبيق الرئيسي ===== */
.main-app {
    display: flex;
    min-height: 100vh;
}

/* القائمة الجانبية */
.sidebar {
    width: 250px;
    background: var(--bg2);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 100;
    transition: 0.3s;
}

.sidebar-logo {
    padding: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
}

.sidebar-logo i {
    font-size: 28px;
    color: var(--accent);
}

.sidebar-logo span {
    font-size: 20px;
    font-weight: 900;
}

.sidebar-nav {
    flex: 1;
    padding: 20px 0;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 25px;
    color: var(--text2);
    text-decoration: none;
    transition: 0.2s;
    border-right: 3px solid transparent;
    font-size: 15px;
}

.nav-item:hover {
    background: var(--card);
    color: var(--text);
}

.nav-item.active {
    color: var(--accent);
    border-right-color: var(--accent);
    background: rgba(229,9,20,0.1);
}

.nav-item i {
    width: 20px;
    text-align: center;
}

.sidebar-footer {
    padding: 20px 25px;
    border-top: 1px solid var(--border);
}

.logout-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text2);
    border-radius: 10px;
    cursor: pointer;
    transition: 0.3s;
    font-family: 'Cairo', sans-serif;
}

.logout-btn:hover {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
}

/* المحتوى */
.content {
    flex: 1;
    margin-right: 250px;
    padding: 30px;
    min-height: 100vh;
}

.section {
    display: none;
    animation: fadeIn 0.4s;
}

.section.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Hero */
.hero {
    background: linear-gradient(135deg, #1a1a25 0%, #2a0a0f 100%);
    border-radius: 20px;
    padding: 60px 40px;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 100%;
    background: radial-gradient(circle, rgba(229,9,20,0.2) 0%, transparent 70%);
}

.hero-content {
    position: relative;
    z-index: 1;
}

.badge {
    background: var(--accent);
    color: white;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}

.hero h2 {
    font-size: 36px;
    margin: 15px 0 10px;
    font-weight: 900;
}

.hero p {
    color: var(--text2);
    margin-bottom: 25px;
    font-size: 16px;
}

.btn-watch {
    padding: 14px 35px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}

.btn-watch:hover {
    background: var(--accent2);
    transform: translateY(-2px);
}

/* العناوين */
.section-title {
    font-size: 22px;
    margin: 30px 0 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-title i {
    color: var(--accent);
}

.page-title {
    font-size: 28px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.page-title i {
    color: var(--accent);
}

/* شبكة البطاقات */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

